# Grant local active desktop users access to Logitech USB and Bluetooth/BLE HID++ (hidraw) devices.
# Numbered 70 (< 73) so TAG+="uaccess" is applied before systemd's 73-seat-late.rules.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:046D:*", TAG+="uaccess"
