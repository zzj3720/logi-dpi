// MouseDPI for macOS, Linux, and Windows: the Liquid Glass window (dpi_ui) over the shared HID++ 2.0 protocol core
// (hidpp_core.c + platform transport hidpp_macos.m / hidpp_linux.c / hidpp_win.c).
//
// Two background threads run beside the UI thread:
// - the worker thread handles commands from the window (`ui::Worker`) without blocking the render thread;
// - the watcher thread initializes/restores DPI on startup and delivers atomic snapshots whenever `mousedpi_wait_rev`
//   advances (wake restore, 30 s refresh, or write completion).

import "dpi_ui"
import "host"
import "hostapi"
import "lg"
import "ui"
import "view"

extern "C" fn c_started_hidden() -> Int = "mousedpi_started_hidden"

extern "C" fn c_peek_config(which : Int) -> Int = "mousedpi_peek_config"

extern "C" fn c_init_and_restore() -> Int = "mousedpi_init_and_restore"

extern "C" fn c_request_refresh() -> Unit = "mousedpi_request_refresh"

extern "C" fn c_request_set(dpi : Int, lod : Int) -> Unit = "mousedpi_request_set"

extern "C" fn c_request_set_seq(seq : Int, dpi : Int, lod : Int) -> Unit = "mousedpi_request_set_seq"

extern "C" fn c_request_wake_restore() -> Unit = "mousedpi_request_wake_restore"

extern "C" fn c_state_rev() -> Int = "mousedpi_state_rev"

extern "C" fn c_wait_rev(seen : Int) -> Int = "mousedpi_wait_rev"

extern "C" fn c_stop_waits() -> Unit = "mousedpi_stop_waits"

extern "C" fn c_snapshot_capture() -> Unit = "mousedpi_snapshot_capture"

extern "C" fn c_snap_rev() -> Int = "mousedpi_snap_rev"

extern "C" fn c_snap_applied_seq() -> Int = "mousedpi_snap_applied_seq"

extern "C" fn c_snap_connected() -> Int = "mousedpi_snap_connected"

extern "C" fn c_snap_dpi_x() -> Int = "mousedpi_snap_dpi_x"

extern "C" fn c_snap_lod() -> Int = "mousedpi_snap_lod"

extern "C" fn c_snap_battery() -> Int = "mousedpi_snap_battery"

extern "C" fn c_snap_perm_denied() -> Int = "mousedpi_snap_perm_denied"

extern "C" fn c_snap_device_name_dup() -> Ptr = "mousedpi_snap_device_name_dup"

extern "C" fn c_picture_path_dup() -> Ptr = "mousedpi_picture_path_dup"

extern "C" fn c_can_hide_to_tray() -> Int = "mousedpi_can_hide_to_tray"

extern "C" fn c_wait_tray_ready(timeout_ms : Int) -> Int = "mousedpi_wait_tray_ready"

extern "C" fn c_autostart() -> Int = "mousedpi_get_autostart"

extern "C" fn c_set_autostart(on : Int) -> Int = "mousedpi_set_autostart"

fn take_c_str(p : Ptr) -> String {
  if p == ptr_null() {
    ""
  } else {
    let s = cstr_to_str(p)
    ptr_free(p)
    s
  }
}

/// Capture an atomic snapshot of the C side's state and return `(Ev::Read, snap_rev)`.
fn read_snapshot() -> (dpi_ui::Ev, Int) {
  c_snapshot_capture()
  let ev = dpi_ui::Ev::Read(
    c_snap_connected() != 0,
    c_snap_dpi_x(),
    c_snap_lod(),
    c_snap_battery(),
    c_snap_perm_denied() != 0,
    take_c_str(c_snap_device_name_dup()),
    c_snap_applied_seq(),
  )
  (ev, c_snap_rev())
}

/// What the window asks, on the worker's thread (none of it blocks: the C side's refresher thread does the HID++).
fn handle(cmd : dpi_ui::Cmd, emit : (dpi_ui::Ev) -> Unit) -> Unit {
  match cmd {
    dpi_ui::Cmd::Refresh => c_request_refresh()
    dpi_ui::Cmd::WakeRestore => c_request_wake_restore()
    dpi_ui::Cmd::Set(seq, dpi, lod) => c_request_set_seq(seq, dpi, lod)
    dpi_ui::Cmd::Autostart(on) => emit(dpi_ui::Ev::Autostarts(c_set_autostart(if on { 1 } else { 0 }) != 0))
  }
}

/// Tray menu for Windows and Linux (only Show + Quit).
let tray_menu : String = "[{\"role\":\"tray\",\"items\":[{\"title\":\"打开 MouseDPI\",\"role\":\"show\"},{\"separator\":true},{\"title\":\"退出\",\"role\":\"quit\"}]}]"

/// Full macOS menu bar (App menu + Window menu) plus opt-in menu bar status item.
let macos_menu : String = "[{\"title\":\"MouseDPI\",\"items\":[{\"title\":\"关于 {app}\",\"role\":\"about\"},{\"separator\":true},{\"title\":\"隐藏 {app}\",\"role\":\"hide\"},{\"title\":\"隐藏其他\",\"role\":\"hideOthers\"},{\"title\":\"全部显示\",\"role\":\"showAll\"},{\"separator\":true},{\"title\":\"退出 {app}\",\"role\":\"quit\"}]},{\"title\":\"窗口\",\"role\":\"window\",\"items\":[{\"title\":\"关闭\",\"role\":\"close\"},{\"title\":\"最小化\",\"role\":\"minimize\"},{\"title\":\"缩放\",\"role\":\"zoom\"},{\"separator\":true},{\"title\":\"进入全屏幕\",\"role\":\"fullScreen\"},{\"separator\":true},{\"title\":\"前置全部窗口\",\"role\":\"front\"}]},{\"role\":\"tray\",\"macos\":true,\"symbol\":\"computermouse.fill\",\"tooltip\":\"MouseDPI\",\"items\":[{\"title\":\"打开 MouseDPI\",\"role\":\"show\"},{\"separator\":true},{\"title\":\"退出\",\"role\":\"quit\"}]}]"

fn main(world : World) -> Int {
  host::install()
  let plat = hostapi::platform()
  let is_macos = plat == 0
  let is_windows = plat == 3
  let is_linux = plat == 5
  // 780 × 360 points, no smaller than 640 × 340, inset title bar on all three desktop platforms.
  hostapi::window_setup(640.0, 340.0, 780.0, 360.0, inset=true)
  hostapi::window_center()
  let want_tray = c_started_hidden() != 0
  let can_tray = c_can_hide_to_tray() != 0
  let linux_tray_watch = is_linux && want_tray && can_tray
  let hidden = want_tray && can_tray
  if hidden {
    // Started in tray mode (e.g. login autostart) when a tray host is available.
    // On Linux this ensures window_shown = 1 in the host (never stuck in held state on tray click),
    // while the watcher task restores the window if SNI registration fails or the tray watcher disappears.
    hostapi::window_hide()
  } else {
    // Keep out of sight until its first frame is drawn, centered, then shown (no jump, no blank flash).
    hostapi::window_hold()
  }
  hostapi::menu_setup(if is_macos { macos_menu } else { tray_menu })
  let pic_raw = take_c_str(c_picture_path_dup())
  let picture = if pic_raw != "" { pic_raw } else { "mouse.png" }
  let close_label = if is_windows || can_tray { "关闭到托盘" } else { "关闭" }
  let perm_hint = if is_macos {
    "请在 系统设置 → 隐私与安全性 → 输入监控 中授权"
  } else if is_windows {
    "请检查 HID 设备访问权限后重试"
  } else {
    "请安装 udev 规则后重新插拔接收器"
  }
  // Seed initial state from config.ini until the receiver answers so startup never flashes "未连接".
  let m = dpi_ui::Mouse::new()
  m.connected.set(true)
  m.dpi.set(c_peek_config(0))
  m.lod.set(c_peek_config(1))
  m.autostart.set(c_autostart() != 0)
  let (worker, ctx) : (ui::Worker[dpi_ui::Cmd, dpi_ui::Ev], ui::WorkerCtx[dpi_ui::Cmd, dpi_ui::Ev]) = ui::Worker::pair()
  let reads : ui::EventQueue[dpi_ui::Ev] = ui::EventQueue::new()
  let tray_decisions : ui::EventQueue[Bool] = ui::EventQueue::new()
  // Register system lifecycle listener before ui::run so Shown/wake events are never missed.
  ui::on_message(hostapi::system_channel, fn(json : String, _bytes : Option[Bytes]) -> Unit {
    for said in hostapi::system_said(json) {
      match said {
        hostapi::SystemSaid::Shown(away) => {
          if is_windows {
            let _ = worker.send(dpi_ui::Cmd::Refresh)
          } else if away >= 5000.0 {
            let _ = worker.send(dpi_ui::Cmd::WakeRestore)
          } else {
            let _ = worker.send(dpi_ui::Cmd::Refresh)
          }
        }
        _ => ()
      }
    }
  })
  scope(world, fn(s : Scope) -> Unit {
    spawn(s, fn() -> Unit { ctx.run_loop(handle) })
    if linux_tray_watch {
      spawn(s, fn() -> Unit {
        let ready = c_wait_tray_ready(1500) != 0
        if !ready {
          // Startup SNI registration failed or timed out: reveal the hidden window.
          tray_decisions.emit(false)
        } else {
          // Confirmed registered: stay watching and reveal only if the tray definitely disappears.
          if c_wait_tray_ready(-1) == 0 {
            tray_decisions.emit(false)
          }
        }
      })
    }
    // The watcher: initialize/restore saved DPI, emit initial atomic snapshot, then relay every revision update.
    spawn(s, fn() -> Unit {
      let _ = c_init_and_restore()
      let (ev0, rev0) = read_snapshot()
      reads.emit(ev0)
      let mut seen = rev0
      while seen >= 0 {
        let next_rev = c_wait_rev(seen)
        if next_rev < 0 {
          seen = next_rev
        } else {
          let (ev, rev) = read_snapshot()
          reads.emit(ev)
          seen = rev
        }
      }
    })
    ui::run(
      "MouseDPI",
      fn(root : view::View) -> Unit {
        dpi_ui::app(
          root,
          m,
          worker,
          window_act=fn(w : Int) -> Unit { hostapi::window_act(w) },
          reads~,
          picture=picture,
          show_window_controls=!is_macos,
          macos_inset=is_macos,
          close_label=close_label,
          perm_hint=perm_hint,
        )
        if is_macos {
          // Align macOS traffic lights vertically with the 44pt top bar (padding top 10 -> y=32).
          // This build callback runs before the native host creates the first window slot, where
          // window_buttons_down is a no-op; defer it once to the first frame, when the slot exists.
          // Do NOT register set_window_close on macOS: let mac_app.m handle native hide/reopen & Shown.
          let aligned : Array[Bool] = [false]
          let _ = ui::on_before_frame(fn() {
            if !aligned[0] {
              aligned[0] = true
              hostapi::window_buttons_down(10.0, 0.0)
            }
          })
        }
        // Shown once its first frame is drawn, unless started hidden in the tray.
        if linux_tray_watch {
          let _ = ui::on_before_frame(fn() {
            let _ = tray_decisions.drain(fn(ready : Bool) -> Unit {
              if !ready {
                hostapi::window_show()
              }
            })
          })
        } else if !hidden {
          hostapi::window_show()
        }
      },
      theme=lg::ui_theme,
    )
    worker.close()
    c_stop_waits()
  })
  0
}
