// MouseDPI for Windows: the Liquid Glass window (dpi_ui) over the HID++ 2.0 side (hidpp_win.c: the receiver, DPI/LOD,
// battery, config.ini, tray, autostart, restoring the DPI as the mouse wakes).

import "dpi_ui"
import "host"
import "hostapi"
import "lg"
import "ui"
import "view"

extern "C" fn c_setup_soon() -> Unit = "mousedpi_setup_soon"

extern "C" fn c_single() -> Int = "mousedpi_single"

extern "C" fn c_init_and_restore() -> Int = "mousedpi_init_and_restore"

extern "C" fn c_request_refresh() -> Unit = "mousedpi_request_refresh"

extern "C" fn c_state_rev() -> Int = "mousedpi_state_rev"

extern "C" fn c_wait_rev(seen : Int) -> Int = "mousedpi_wait_rev"

extern "C" fn c_stop_waits() -> Unit = "mousedpi_stop_waits"

extern "C" fn c_peek_config(which : Int) -> Int = "mousedpi_peek_config"

extern "C" fn c_connected() -> Int = "mousedpi_get_connected"

extern "C" fn c_request_set(dpi : Int, lod : Int) -> Unit = "mousedpi_request_set"

extern "C" fn c_dpi_x() -> Int = "mousedpi_get_dpi_x"

extern "C" fn c_lod() -> Int = "mousedpi_get_lod"

extern "C" fn c_battery() -> Int = "mousedpi_get_battery"

extern "C" fn c_autostart() -> Int = "mousedpi_get_autostart"

extern "C" fn c_set_autostart(on : Int) -> Int = "mousedpi_set_autostart"

let win_w : Int = 780

let win_h : Int = 500

/// What a read of the mouse found, from the reader thread to the window's (`ok`: the receiver answered).
struct Read {
  ok : Int
  dpi : Int
  lod : Int
  battery : Int
}

fn read_now(ok : Int) -> Read {
  Read::{ ok, dpi: c_dpi_x(), lod: c_lod(), battery: c_battery() }
}

/// When the window last asked for a DPI/LOD (hostapi::now): what the C side read back before that write lands is
/// older than what is shown, so it is not taken for a while.
let last_asked : Array[Double] = [-100000.0]

/// A read into the window's signals.
fn take(m : dpi_ui::Mouse, r : Read) -> Unit {
  m.connected.set(r.ok != 0)
  if r.ok != 0 {
    if hostapi::now() - last_asked[0] > 1500.0 {
      m.dpi.set(r.dpi)
      m.lod.set(r.lod)
    }
    m.battery.set(r.battery)
  }
}

fn main(world : World) -> Int {
  // one MouseDPI at a time: a second start brings the running one to the front and ends
  if c_single() == 0 {
    return 0
  }
  host::install()
  // the window as the app opens it: 780 × 500 points, no smaller than 640 × 440, its top row the app's (no title bar of
  // the system's: the Liquid Glass page is the whole window)
  hostapi::window_setup(640.0, 440.0, win_w.to_double(), win_h.to_double(), true)
  // held out of sight till the C side has centred it (mousedpi_setup_soon shows it then)
  hostapi::window_hold()
  // shown as config.ini last had it till the mouse answers (read on the reader thread, not this one; opening the
  // receiver there can take ~350 ms while the GPU's driver loads beside it): taken as there, not "未连接" for a moment
  let m = dpi_ui::Mouse::new()
  m.connected.set(true)
  m.dpi.set(c_peek_config(0))
  m.lod.set(c_peek_config(1))
  m.autostart.set(c_autostart() != 0)
  let d = dpi_ui::Device::{
    refresh: fn() { c_request_refresh() },
    // shown at once; written by the C side's thread (the newest asked), its read back taken as the reader brings it
    set_dpi: fn(x : Int, lod : Int) -> Unit {
      last_asked[0] = hostapi::now()
      m.dpi.set(x)
      m.lod.set(lod)
      c_request_set(x, lod)
    },
    set_autostart: fn(on : Bool) -> Unit { m.autostart.set(c_set_autostart(if on { 1 } else { 0 }) != 0) },
    window_act: fn(what : Int) -> Unit { hostapi::window_act(what) },
  }
  // the mouse read off this thread: the reader opens it (putting back the DPI config.ini keeps), then waits for each
  // read the C side's refresher does (every 30 s, when asked, a DPI the wake guard put back) and hands it over, the
  // window woken for it (ui::EventQueue: taken before the next frame, from inside the tree's maker: ui::run forgets
  // hooks set before it)
  let reads : ui::EventQueue[Read] = ui::EventQueue::new()
  // the window styled and given its tray icon by the C side as soon as it is up (raw input, power, close to tray)
  c_setup_soon()
  scope(world, fn(s : Scope) -> Unit {
    spawn(s, fn() -> Unit {
      let first = c_init_and_restore()
      reads.emit(read_now(first))
      let mut seen = c_state_rev()
      while seen >= 0 {
        seen = c_wait_rev(seen)
        if seen >= 0 {
          reads.emit(read_now(c_connected()))
        }
      }
    })
    ui::run(
      "PRO X2 SUPERSTRIKE",
      fn(root : view::View) -> Unit {
        let _ = ui::on_before_frame(fn() { let _ = reads.drain(fn(r : Read) { take(m, r) }) })
        dpi_ui::app(root, m, d, picture="mouse.png")
      },
      theme=lg::ui_theme,
    )
    c_stop_waits()
  })
  0
}
