// MouseDPI for Windows: the Liquid Glass window (dpi_ui) over the HID++ 2.0 side (hidpp_win.c: the receiver, DPI/LOD,
// battery, config.ini, autostart, restoring the DPI as the mouse wakes).
//
// The program is an app of invar's Windows host (MBUI_APP_ID in assets/mbui_env.txt): the host runs it once per person
// (a second start brings the window back), puts the window away to its tray icon as it closes, and brings it back from
// there; the tray menu is the app's (menu_setup). Two threads beside the window's: the worker does what the window
// asks (ui::Worker), the watcher hands over each read of the mouse the C side's own threads did (every 30 s, after a
// write, as the mouse wakes).

import "dpi_ui"
import "host"
import "hostapi"
import "lg"
import "ui"
import "view"

extern "C" fn c_started_hidden() -> Int = "mousedpi_started_hidden"

extern "C" fn c_peek_config(which : Int) -> Int = "mousedpi_peek_config"

extern "C" fn c_init_and_restore() -> Int = "mousedpi_init_and_restore"

extern "C" fn c_request_refresh() -> Unit = "mousedpi_request_refresh"

extern "C" fn c_request_set(dpi : Int, lod : Int) -> Unit = "mousedpi_request_set"

extern "C" fn c_state_rev() -> Int = "mousedpi_state_rev"

extern "C" fn c_wait_rev(seen : Int) -> Int = "mousedpi_wait_rev"

extern "C" fn c_stop_waits() -> Unit = "mousedpi_stop_waits"

extern "C" fn c_connected() -> Int = "mousedpi_get_connected"

extern "C" fn c_dpi_x() -> Int = "mousedpi_get_dpi_x"

extern "C" fn c_lod() -> Int = "mousedpi_get_lod"

extern "C" fn c_battery() -> Int = "mousedpi_get_battery"

extern "C" fn c_autostart() -> Int = "mousedpi_get_autostart"

extern "C" fn c_set_autostart(on : Int) -> Int = "mousedpi_set_autostart"

/// The C side's last read, as the window takes it.
fn read_now(ok : Int) -> dpi_ui::Ev {
  dpi_ui::Ev::Read(ok != 0, c_dpi_x(), c_lod(), c_battery())
}

/// What the window asks, on the worker's thread (none of it blocks: the C side's refresher thread does the HID++).
fn handle(cmd : dpi_ui::Cmd, emit : (dpi_ui::Ev) -> Unit) -> Unit {
  match cmd {
    dpi_ui::Cmd::Refresh => c_request_refresh()
    dpi_ui::Cmd::Set(dpi, lod) => c_request_set(dpi, lod)
    dpi_ui::Cmd::Autostart(on) => emit(dpi_ui::Ev::Autostarts(c_set_autostart(if on { 1 } else { 0 }) != 0))
  }
}

/// The tray icon's menu (the host's icon; its words the app's).
let tray_menu : String = "[{\"role\":\"tray\",\"items\":[{\"title\":\"打开 MouseDPI\",\"role\":\"show\"},{\"separator\":true},{\"title\":\"退出\",\"role\":\"quit\"}]}]"

fn main(world : World) -> Int {
  host::install()
  // 780 × 360 points (what the page holds), no smaller than 640 × 340, the page the whole window (no title bar of the system's)
  hostapi::window_setup(640.0, 340.0, 780.0, 360.0, true)
  hostapi::window_center()
  let hidden = c_started_hidden() != 0
  if hidden {
    // started with Windows: in the tray till it is brought back
    hostapi::window_hide()
  } else {
    // out of sight till its first frame is drawn, centred, then shown (no jump, no blank window)
    hostapi::window_hold()
  }
  hostapi::menu_setup(tray_menu)
  // shown as config.ini last had it till the mouse answers (opening the receiver can take ~350 ms while the GPU's
  // driver loads beside it): taken as there, not "未连接" for a moment
  let m = dpi_ui::Mouse::new()
  m.connected.set(true)
  m.dpi.set(c_peek_config(0))
  m.lod.set(c_peek_config(1))
  m.autostart.set(c_autostart() != 0)
  let (worker, ctx) : (ui::Worker[dpi_ui::Cmd, dpi_ui::Ev], ui::WorkerCtx[dpi_ui::Cmd, dpi_ui::Ev]) = ui::Worker::pair()
  let reads : ui::EventQueue[dpi_ui::Ev] = ui::EventQueue::new()
  scope(world, fn(s : Scope) -> Unit {
    spawn(s, fn() -> Unit { ctx.run_loop(handle) })
    // the watcher: the mouse opened (the DPI config.ini keeps put back), then each read the C side does handed over
    spawn(s, fn() -> Unit {
      let first = c_init_and_restore()
      reads.emit(read_now(first))
      let mut seen = c_state_rev()
      while seen >= 0 {
        seen = c_wait_rev(seen)
        if seen >= 0 {
          reads.emit(read_now(c_connected()))
        }
      }
    })
    ui::run(
      "PRO X2 SUPERSTRIKE",
      fn(root : view::View) -> Unit {
        dpi_ui::app(root, m, worker, window_act=fn(w : Int) -> Unit { hostapi::window_act(w) }, reads~, picture="mouse.png")
        // shown once its first frame is drawn, unless it started in the tray (brought back from there by the host)
        if !hidden {
          hostapi::window_show()
        }
      },
      theme=lg::ui_theme,
    )
    worker.close()
    c_stop_waits()
  })
  0
}
