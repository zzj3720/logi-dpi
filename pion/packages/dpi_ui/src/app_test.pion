// The window over a stand-in mouse (`Worker::inline`): invar's Apple two-layer gate (no glass on glass, content layer
// solid, nothing unscrollable, craft, shadow_clip_faults) across light/dark, connected/disconnected/low-battery/perm-denied,
// macOS/WinLinux chrome, dynamic battery 21->20->21->-1, and 640x340 minimum size with a long device name.

import "lg"
import "ui"
import "view"

fn window(
  m : Mouse,
  worker : ui::Worker[Cmd, Ev],
  acts : Array[Int],
  width~ : Double = 780.0,
  height~ : Double = 360.0,
  show_window_controls~ : Bool = true,
  macos_inset~ : Bool = false,
  close_label~ : String = "关闭到托盘",
  perm_hint~ : String = "请安装 udev 规则或在系统设置中授予权限",
  reads? : ui::EventQueue[Ev],
  platform~ : Int = 3,
) -> ui::Tester {
  ui::Tester::tree(
    fn(root : view::View) -> Unit {
      match reads {
        Some(q) =>
          app(
            root,
            m,
            worker,
            window_act=fn(w : Int) -> Unit { acts.push(w) },
            reads=q,
            picture="",
            show_window_controls=show_window_controls,
            macos_inset=macos_inset,
            close_label=close_label,
            perm_hint=perm_hint,
          )
        None =>
          app(
            root,
            m,
            worker,
            window_act=fn(w : Int) -> Unit { acts.push(w) },
            picture="",
            show_window_controls=show_window_controls,
            macos_inset=macos_inset,
            close_label=close_label,
            perm_hint=perm_hint,
          )
      }
    },
    width=width,
    height=height,
    platform=platform,
    theme=lg::ui_theme,
  )
}

fn assert_clean_ui(t : ui::Tester, label : String) -> Unit {
  lg::assert_apple_ui(t, label=label)
  let sf = t.shadow_clip_faults(sigma=2.0, include_viewport=false)
  if sf.length() > 0 {
    debug_assert(false, "[\{label}] shadow_clip_faults (\{sf.length()}): \{sf[0]}")
  }
}

test "dpi window passes apple two-layer gate across light/dark, states, and macOS/WinLinux chrome" {
  for dark in [false, true] {
    for is_mac in [false, true] {
      // 1. Connected normal battery
      lg::set_dark(Some(dark))
      let m = Mouse::new()
      m.connected.set(true)
      m.dpi.set(1600)
      m.battery.set(76)
      let worker = ui::Worker::inline(stand_in(76))
      let t = window(
        m,
        worker,
        [],
        show_window_controls=!is_mac,
        macos_inset=is_mac,
        close_label=if is_mac { "关闭" } else { "关闭到托盘" },
        platform=if is_mac { 0 } else { 3 },
      )
      if is_mac {
        t.fake.window_inset_flag = true
        t.fake.frame_requested = true
      }
      t.frame()
      debug_assert(t.find("PRO X2 SUPERSTRIKE").is_some(), "title is shown")
      debug_assert(t.find("1600").is_some(), "DPI is read out")
      debug_assert(t.find("电量 76%").is_some(), "battery shows while connected")
      debug_assert(t.get("最小化").is_some() == !is_mac, "window controls only on Win/Linux")
      assert_clean_ui(t, "dpi_conn_dark_\{dark}_mac_\{is_mac}")
      worker.close()
      t.dispose()

      // 2. Disconnected
      let m_off = Mouse::new()
      m_off.connected.set(false)
      m_off.dpi.set(800)
      m_off.battery.set(-1)
      let w_off = ui::Worker::inline(stand_in(76))
      let t_off = window(
        m_off,
        w_off,
        [],
        show_window_controls=!is_mac,
        macos_inset=is_mac,
        platform=if is_mac { 0 } else { 5 },
      )
      if is_mac {
        t_off.fake.window_inset_flag = true
        t_off.fake.frame_requested = true
      }
      t_off.frame()
      debug_assert(t_off.find("未连接").is_some(), "offline subtitle")
      debug_assert(t_off.find("电量 76%").is_none(), "no battery while offline")
      assert_clean_ui(t_off, "dpi_off_dark_\{dark}_mac_\{is_mac}")
      w_off.close()
      t_off.dispose()

      // 3. Low battery
      let m_low = Mouse::new()
      m_low.connected.set(true)
      m_low.dpi.set(1200)
      m_low.battery.set(15)
      let w_low = ui::Worker::inline(stand_in(15))
      let t_low = window(
        m_low,
        w_low,
        [],
        show_window_controls=!is_mac,
        macos_inset=is_mac,
        platform=if is_mac { 0 } else { 3 },
      )
      t_low.frame()
      debug_assert(t_low.find("电量 15%").is_some(), "low battery badge shown")
      assert_clean_ui(t_low, "dpi_low_dark_\{dark}_mac_\{is_mac}")
      w_low.close()
      t_low.dispose()

      // 4. Permission denied
      let m_perm = Mouse::new()
      m_perm.connected.set(false)
      m_perm.perm_denied.set(true)
      m_perm.dpi.set(800)
      m_perm.battery.set(-1)
      let w_perm = ui::Worker::inline(stand_in(-1, perm_denied=true))
      let t_perm = window(
        m_perm,
        w_perm,
        [],
        show_window_controls=!is_mac,
        macos_inset=is_mac,
        close_label="关闭",
        platform=if is_mac { 0 } else { 5 },
      )
      t_perm.frame()
      debug_assert(t_perm.find("需要 HID 权限").is_some(), "perm_denied subtitle shown")
      assert_clean_ui(t_perm, "dpi_perm_dark_\{dark}_mac_\{is_mac}")
      w_perm.close()
      t_perm.dispose()
    }
  }
  lg::set_dark(None)
}

test "dynamic battery transitions 21 -> 20 -> 21 -> -1 on the same tree" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  m.battery.set(21)
  let worker = ui::Worker::inline(stand_in(21))
  let t = window(m, worker, [])
  t.frame()
  debug_assert(t.find("电量 21%").is_some(), "battery 21% shown in Success branch")
  assert_clean_ui(t, "dyn_bat_21")

  m.battery.set(20)
  t.frame(ms=16.0)
  debug_assert(t.find("电量 20%").is_some(), "battery 20% shown in Warning branch")
  debug_assert(t.find("电量 21%").is_none(), "old 21% badge hidden")
  assert_clean_ui(t, "dyn_bat_20")

  m.battery.set(21)
  t.frame(ms=16.0)
  debug_assert(t.find("电量 21%").is_some(), "battery 21% restored in Success branch")
  debug_assert(t.find("电量 20%").is_none(), "old 20% badge hidden")
  assert_clean_ui(t, "dyn_bat_21_again")

  m.battery.set(-1)
  t.frame(ms=16.0)
  debug_assert(t.find("电量 21%").is_none(), "negative battery hides badge")
  assert_clean_ui(t, "dyn_bat_neg")

  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "minimum 640x340 window with long device name passes apple ui and shadow clip gates" {
  lg::set_dark(Some(false))
  let m = Mouse::new()
  m.connected.set(true)
  m.dpi.set(3200)
  m.battery.set(88)
  m.device_name.set("PRO X SUPERLIGHT 2 DEX WIRELESS GAMING MOUSE")
  let worker = ui::Worker::inline(stand_in(88, device_name="PRO X SUPERLIGHT 2 DEX WIRELESS GAMING MOUSE"))
  let t = window(m, worker, [], width=640.0, height=340.0, show_window_controls=true, close_label="关闭")
  t.frame()
  debug_assert(t.find("3200").is_some(), "DPI shown at 640x340")
  debug_assert(t.find("电量 88%").is_some(), "battery shown at 640x340")
  assert_clean_ui(t, "min_640x340_long_name")
  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "the controls ask the worker, and its reads come back into the window" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  let worker = ui::Worker::inline(stand_in(55, device_name="G PRO X SUPERLIGHT 2"))
  let acts : Array[Int] = []
  let t = window(m, worker, acts)
  t.frame()
  // a preset: shown at once, written (the stand-in reads back what was written)
  t.press("1200")
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 1200, "a preset sets the DPI, got \{m.dpi.untracked()}")
  // lift-off distance
  t.press("高")
  t.frame(ms=16.0)
  debug_assert(m.lod.untracked() == 3, "the segmented control sets LOD 3, got \{m.lod.untracked()}")
  debug_assert(m.dpi.untracked() == 1200, "the DPI stays as LOD changes")
  // refresh: a read with the battery and dynamic device name comes back
  t.press("刷新")
  t.frame(ms=16.0)
  debug_assert(m.battery.untracked() == 55, "refresh reads the battery, got \{m.battery.untracked()}")
  debug_assert(m.device_name.untracked() == "G PRO X SUPERLIGHT 2", "refresh updates dynamic device name")
  // autostart toggle
  t.press("开机自启")
  t.frame(ms=16.0)
  debug_assert(m.autostart.untracked(), "the toggle asks for autostart and takes the worker's answer")
  // the window's own buttons
  t.press("最小化")
  t.press("关闭到托盘")
  debug_assert(acts.length() == 2 && acts[0] == 1 && acts[1] == 3, "minimize is 1, close (to the tray) is 3")
  assert_clean_ui(t, "dpi_after_controls")
  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "sequence readback ignores stale reads, snaps back on device rejection, and clamps slider above max" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  m.dpi.set(800)
  m.lod.set(3)
  let sets : Array[(Int, Int, Int, Int)] = []
  let worker = ui::Worker::inline(fn(cmd : Cmd, _emit : (Ev) -> Unit) -> Unit {
    match cmd {
      Cmd::Set(seq, tok, d, l) => sets.push((seq, tok, d, l))
      _ => ()
    }
  })
  let reads : ui::EventQueue[Ev] = ui::EventQueue::new()
  let t = window(m, worker, [], reads=reads)
  t.frame()

  // Seed device A with target_token=7 so UI binds Set commands to token 7.
  reads.emit(Ev::Read(true, 800, 3, 72, false, "Mouse A", 0, 7))
  t.frame(ms=16.0)

  // UI initiates Set(seq=1, token=7, 1600, 3) optimistically.
  t.press("1600")
  t.frame(ms=16.0)
  debug_assert(sets.length() == 1, "expected 1 Set command, got \{sets.length()}")
  let (s_seq, s_tok, s_dpi, s_lod) = sets[0]
  debug_assert(s_seq == 1 && s_tok == 7 && s_dpi == 1600 && s_lod == 3, "expected Set(1, 7, 1600, 3), got (\{s_seq}, \{s_tok}, \{s_dpi}, \{s_lod})")
  debug_assert(m.dpi.untracked() == 1600 && m.lod.untracked() == 3, "optimistic update applied")

  // Stale concurrent read (applied_seq=0 < pending_seq=1): DPI/LOD must be ignored, battery still updates.
  reads.emit(Ev::Read(true, 800, 2, 72, false, "PRO X2 SUPERSTRIKE", 0, 7))
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 1600, "stale read must not overwrite DPI, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 3, "stale read must not overwrite LOD, got \{m.lod.untracked()}")
  debug_assert(m.battery.untracked() == 72, "stale read still updates battery, got \{m.battery.untracked()}")

  // Device rejection readback (applied_seq=1 >= pending_seq=1): must immediately snap back to real 800/2.
  reads.emit(Ev::Read(true, 800, 2, 72, false, "PRO X2 SUPERSTRIKE", 1, 7))
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 800, "rejected write must immediately snap DPI back to 800, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 2, "rejected write must immediately snap LOD back to 2, got \{m.lod.untracked()}")

  // Out-of-slider-range DPI from external software (>4000): slider clamps safely while readout shows real value.
  reads.emit(Ev::Read(true, 6400, 2, 72, false, "PRO X2 SUPERSTRIKE", 1, 7))
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 6400, "real DPI 6400 preserved")
  debug_assert(t.find("6400").is_some(), "real DPI 6400 displayed")
  assert_clean_ui(t, "seq_reject_and_clamp")

  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "offline write failure reverts optimistic DPI/LOD (including 100-199 DPI) without clobbering offline startup" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  m.dpi.set(150)
  m.lod.set(2)
  let sets : Array[(Int, Int, Int, Int)] = []
  let worker = ui::Worker::inline(fn(cmd : Cmd, _emit : (Ev) -> Unit) -> Unit {
    match cmd {
      Cmd::Set(seq, tok, d, l) => sets.push((seq, tok, d, l))
      _ => ()
    }
  })
  let reads : ui::EventQueue[Ev] = ui::EventQueue::new()
  let t = window(m, worker, [], reads=reads)
  t.frame()

  // An offline startup snapshot at seq=0 must preserve config-seeded DPI (150) instead of clobbering it with 800.
  reads.emit(Ev::Read(false, 800, 3, -1, false, "PRO X2 SUPERSTRIKE", 0, 0))
  t.frame(ms=16.0)
  debug_assert(!m.connected.untracked(), "offline startup marks disconnected")
  debug_assert(m.dpi.untracked() == 150, "offline startup must preserve seeded 150 DPI, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 2, "offline startup must preserve seeded LOD 2, got \{m.lod.untracked()}")

  // Online confirmed 150 DPI (token 3), then user clicks 1600 and the mouse disconnects before write completes.
  reads.emit(Ev::Read(true, 150, 2, 80, false, "PRO X2 SUPERSTRIKE", 0, 3))
  t.frame(ms=16.0)
  t.press("1600")
  t.frame(ms=16.0)
  debug_assert(sets.length() == 1, "expected 1 Set command, got \{sets.length()}")
  let (seq, tok, s_dpi, _) = sets[0]
  debug_assert(tok == 3 && s_dpi == 1600, "expected Set(_, 3, 1600, _), got tok=\{tok} dpi=\{s_dpi}")
  debug_assert(m.dpi.untracked() == 1600, "optimistic update applied")

  reads.emit(Ev::Read(false, 150, 2, -1, false, "PRO X2 SUPERSTRIKE", seq, 3))
  t.frame(ms=16.0)
  debug_assert(!m.connected.untracked(), "offline snapshot marks the mouse disconnected")
  debug_assert(m.dpi.untracked() == 150, "failed write must revert DPI to 150, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 2, "failed write must revert LOD to 2, got \{m.lod.untracked()}")

  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "macos 640x340 minimum size with 63-byte device name and low-battery or perm-denied passes gates" {
  let long_name = "Logitech G PRO X2 SUPERSTRIKE LIGHTSPEED WIRELESS GAMING MOUSE!"
  debug_assert(long_name.length() == 63, "test device name should be 63 bytes, got \{long_name.length()}")
  for dark in [false, true] {
    lg::set_dark(Some(dark))

    // Low battery at 640x340 macOS inset chrome
    let m_low = Mouse::new()
    m_low.connected.set(true)
    m_low.dpi.set(1600)
    m_low.battery.set(15)
    m_low.device_name.set(long_name)
    let w_low = ui::Worker::inline(stand_in(15, device_name=long_name))
    let t_low = window(
      m_low,
      w_low,
      [],
      width=640.0,
      height=340.0,
      show_window_controls=false,
      macos_inset=true,
      platform=0,
    )
    t_low.fake.window_inset_flag = true
    t_low.fake.frame_requested = true
    t_low.frame()
    debug_assert(t_low.find("电量 15%").is_some(), "low battery badge shown at 640x340 macOS")
    assert_clean_ui(t_low, "macos_640x340_63b_low_dark_\{dark}")
    w_low.close()
    t_low.dispose()

    // Permission denied at 640x340 macOS inset chrome with macOS-specific hint
    let mac_hint = "请在 系统设置 → 隐私与安全性 → 输入监控 中授权"
    let m_perm = Mouse::new()
    m_perm.connected.set(false)
    m_perm.perm_denied.set(true)
    m_perm.dpi.set(800)
    m_perm.battery.set(-1)
    m_perm.device_name.set(long_name)
    let w_perm = ui::Worker::inline(stand_in(-1, device_name=long_name, perm_denied=true))
    let t_perm = window(
      m_perm,
      w_perm,
      [],
      width=640.0,
      height=340.0,
      show_window_controls=false,
      macos_inset=true,
      perm_hint=mac_hint,
      platform=0,
    )
    t_perm.fake.window_inset_flag = true
    t_perm.fake.frame_requested = true
    t_perm.frame()
    debug_assert(t_perm.find("需要 HID 权限").is_some(), "perm denied subtitle shown at 640x340 macOS")
    debug_assert(t_perm.find(mac_hint).is_some(), "macos perm_hint shown")
    assert_clean_ui(t_perm, "macos_640x340_63b_perm_dark_\{dark}")
    w_perm.close()
    t_perm.dispose()
  }
  lg::set_dark(None)
}

test "target switch cancels pending optimistic state from previous mouse before combining DPI/LOD" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  m.dpi.set(800)
  m.lod.set(2)
  let sets : Array[(Int, Int, Int, Int)] = []
  let worker = ui::Worker::inline(fn(cmd : Cmd, _emit : (Ev) -> Unit) -> Unit {
    match cmd {
      Cmd::Set(seq, tok, d, l) => sets.push((seq, tok, d, l))
      _ => ()
    }
  })
  let reads : ui::EventQueue[Ev] = ui::EventQueue::new()
  let t = window(m, worker, [], reads=reads)
  t.frame()

  // Seed Mouse A (token=7, 800 DPI, LOD 2).
  reads.emit(Ev::Read(true, 800, 2, 80, false, "Mouse A", 0, 7))
  t.frame(ms=16.0)

  // User sets DPI=1600 on Mouse A; write is still queued/unconfirmed (pending_seq=1, pending_token=7).
  t.press("1600")
  t.frame(ms=16.0)
  debug_assert(sets.length() == 1, "expected 1 Set command for Mouse A")
  let (s1_seq, s1_tok, s1_dpi, s1_lod) = sets[0]
  debug_assert(s1_seq == 1 && s1_tok == 7 && s1_dpi == 1600 && s1_lod == 2, "expected Set(1, 7, 1600, 2)")
  debug_assert(m.dpi.untracked() == 1600, "optimistic DPI 1600 on Mouse A")

  // Mouse B connects and delivers its first snapshot with an OLD applied_seq=0 (< pending_seq=1).
  reads.emit(Ev::Read(true, 1200, 1, 90, false, "Mouse B", 0, 8))
  t.frame(ms=16.0)
  debug_assert(m.device_name.untracked() == "Mouse B", "UI switched to Mouse B")
  debug_assert(m.dpi.untracked() == 1200, "target switch must immediately adopt Mouse B's 1200 DPI, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 1, "target switch must immediately adopt Mouse B's LOD 1, got \{m.lod.untracked()}")

  // User changes ONLY LOD on Mouse B ("高" = LOD 3): DPI sent to B MUST remain B's 1200 (never A's 1600).
  t.press("高")
  t.frame(ms=16.0)
  debug_assert(sets.length() == 2, "expected 2 Set commands")
  let (s2_seq, s2_tok, s2_dpi, s2_lod) = sets[1]
  debug_assert(
    s2_seq == 2 && s2_tok == 8 && s2_dpi == 1200 && s2_lod == 3,
    "expected Set(2, 8, 1200, 3) on Mouse B, got (\{s2_seq}, \{s2_tok}, \{s2_dpi}, \{s2_lod})",
  )

  // Reverse direction: while B's LOD 3 write (seq=2) is still unconfirmed, Mouse C connects with old applied_seq=1.
  reads.emit(Ev::Read(true, 2000, 1, 65, false, "Mouse C", 1, 9))
  t.frame(ms=16.0)
  debug_assert(m.device_name.untracked() == "Mouse C", "UI switched to Mouse C")
  debug_assert(m.dpi.untracked() == 2000 && m.lod.untracked() == 1, "target switch must immediately adopt Mouse C's 2000/1")

  // User changes ONLY DPI on Mouse C (3200): LOD sent to C MUST remain C's 1 (never B's 3).
  t.press("3200")
  t.frame(ms=16.0)
  debug_assert(sets.length() == 3, "expected 3 Set commands")
  let (s3_seq, s3_tok, s3_dpi, s3_lod) = sets[2]
  debug_assert(
    s3_seq == 3 && s3_tok == 9 && s3_dpi == 3200 && s3_lod == 1,
    "expected Set(3, 9, 3200, 1) on Mouse C, got (\{s3_seq}, \{s3_tok}, \{s3_dpi}, \{s3_lod})",
  )

  // Stale applied_seq=2 for Mouse C (e.g. from rejecting B's stale seq=2) must NOT clobber C's pending seq=3.
  reads.emit(Ev::Read(true, 2000, 1, 65, false, "Mouse C", 2, 9))
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 3200, "stale seq=2 on Mouse C must keep pending 3200 DPI, got \{m.dpi.untracked()}")

  // Confirmation seq=3 on Mouse C applies cleanly.
  reads.emit(Ev::Read(true, 3200, 1, 64, false, "Mouse C", 3, 9))
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 3200 && m.lod.untracked() == 1 && m.battery.untracked() == 64, "confirmed seq=3 on Mouse C")

  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "mid-drag slider across device switch cancels A gesture and never writes A's DPI to B" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  m.dpi.set(800)
  m.lod.set(2)
  let sets : Array[(Int, Int, Int, Int)] = []
  let worker = ui::Worker::inline(fn(cmd : Cmd, _emit : (Ev) -> Unit) -> Unit {
    match cmd {
      Cmd::Set(seq, tok, d, l) => sets.push((seq, tok, d, l))
      _ => ()
    }
  })
  let reads : ui::EventQueue[Ev] = ui::EventQueue::new()
  let t = window(m, worker, [], reads=reads)
  t.frame()

  // Seed Mouse A (token=7, 800 DPI, LOD 2).
  reads.emit(Ev::Read(true, 800, 2, 80, false, "Mouse A", 0, 7))
  t.frame(ms=16.0)

  let slider = match t.get("DPI", role=view::Role::Slider) {
    Some(d) => d
    None => {
      debug_assert(false, "DPI slider should be present")
      abort("missing slider")
    }
  }
  let cy = slider.y + slider.h / 2.0
  let x_start = slider.x + slider.w * 0.16
  let x_drag = slider.x + slider.w * 0.75
  let x_after = slider.x + slider.w * 0.85

  // Begin dragging the DPI slider on Mouse A without releasing.
  t.press_at(x_start, cy)
  t.move_to(x_drag, cy)
  debug_assert(sets.length() == 0, "dragging slider must not commit before release")
  debug_assert(m.dpi.untracked() != 800, "slider preview should follow pointer during A drag, got \{m.dpi.untracked()}")

  // Mid-drag: Mouse A disconnects and Mouse B connects with 1200 DPI / LOD 1 (token=8).
  reads.emit(Ev::Read(true, 1200, 1, 90, false, "Mouse B", 0, 8))
  t.frame(ms=16.0)
  debug_assert(m.device_name.untracked() == "Mouse B", "UI switched to Mouse B mid-drag")
  debug_assert(m.dpi.untracked() == 1200, "Mouse B snapshot must immediately restore 1200 DPI, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 1, "Mouse B snapshot must immediately restore LOD 1, got \{m.lod.untracked()}")

  // Continue moving and release the in-flight pointer gesture started on A:
  // must NOT update B's preview and must NOT send any Set command to B.
  t.move_to(x_after, cy)
  t.release(x_after, cy)
  debug_assert(sets.length() == 0, "releasing A's mid-drag gesture after switching to B must send 0 Sets, got \{sets.length()}")
  debug_assert(m.dpi.untracked() == 1200, "Mouse B must still display 1200 DPI after release, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 1, "Mouse B must still display LOD 1 after release, got \{m.lod.untracked()}")

  // A brand-new drag gesture started on Mouse B still works normally and binds to token=8.
  let slider_b = match t.get("DPI", role=view::Role::Slider) {
    Some(d) => d
    None => {
      debug_assert(false, "DPI slider should remain present for Mouse B")
      abort("missing slider B")
    }
  }
  let cy_b = slider_b.y + slider_b.h / 2.0
  t.drag(slider_b.x + slider_b.w * 0.25, cy_b, slider_b.x + slider_b.w * 0.5, cy_b)
  debug_assert(sets.length() == 1, "new drag on Mouse B must emit 1 Set, got \{sets.length()}")
  let (b_seq, b_tok, _, b_lod) = sets[0]
  debug_assert(b_seq == 1 && b_tok == 8 && b_lod == 1, "expected Set(1, 8, _, 1) on Mouse B, got (\{b_seq}, \{b_tok}, _, \{b_lod})")
  assert_clean_ui(t, "mid_drag_switch")

  worker.close()
  t.dispose()
  lg::set_dark(None)
}
