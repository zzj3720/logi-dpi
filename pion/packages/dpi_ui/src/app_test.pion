// The window over a stand-in mouse (`Worker::inline`): invar's Apple two-layer gate (no glass on glass, content layer
// solid, nothing unscrollable, craft, shadow_clip_faults) across light/dark, connected/disconnected/low-battery/perm-denied,
// macOS/WinLinux chrome, dynamic battery 21->20->21->-1, and 640x340 minimum size with a long device name.

import "lg"
import "ui"
import "view"

fn window(
  m : Mouse,
  worker : ui::Worker[Cmd, Ev],
  acts : Array[Int],
  width~ : Double = 780.0,
  height~ : Double = 360.0,
  show_window_controls~ : Bool = true,
  macos_inset~ : Bool = false,
  close_label~ : String = "关闭到托盘",
  perm_hint~ : String = "请安装 udev 规则或在系统设置中授予权限",
  reads? : ui::EventQueue[Ev],
  platform~ : Int = 3,
) -> ui::Tester {
  ui::Tester::tree(
    fn(root : view::View) -> Unit {
      match reads {
        Some(q) =>
          app(
            root,
            m,
            worker,
            window_act=fn(w : Int) -> Unit { acts.push(w) },
            reads=q,
            picture="",
            show_window_controls=show_window_controls,
            macos_inset=macos_inset,
            close_label=close_label,
            perm_hint=perm_hint,
          )
        None =>
          app(
            root,
            m,
            worker,
            window_act=fn(w : Int) -> Unit { acts.push(w) },
            picture="",
            show_window_controls=show_window_controls,
            macos_inset=macos_inset,
            close_label=close_label,
            perm_hint=perm_hint,
          )
      }
    },
    width=width,
    height=height,
    platform=platform,
    theme=lg::ui_theme,
  )
}

fn assert_clean_ui(t : ui::Tester, label : String) -> Unit {
  lg::assert_apple_ui(t, label=label)
  let sf = t.shadow_clip_faults(sigma=2.0, include_viewport=false)
  if sf.length() > 0 {
    debug_assert(false, "[\{label}] shadow_clip_faults (\{sf.length()}): \{sf[0]}")
  }
}

test "dpi window passes apple two-layer gate across light/dark, states, and macOS/WinLinux chrome" {
  for dark in [false, true] {
    for is_mac in [false, true] {
      // 1. Connected normal battery
      lg::set_dark(Some(dark))
      let m = Mouse::new()
      m.connected.set(true)
      m.dpi.set(1600)
      m.battery.set(76)
      let worker = ui::Worker::inline(stand_in(76))
      let t = window(
        m,
        worker,
        [],
        show_window_controls=!is_mac,
        macos_inset=is_mac,
        close_label=if is_mac { "关闭" } else { "关闭到托盘" },
        platform=if is_mac { 0 } else { 3 },
      )
      if is_mac {
        t.fake.window_inset_flag = true
        t.fake.frame_requested = true
      }
      t.frame()
      debug_assert(t.find("PRO X2 SUPERSTRIKE").is_some(), "title is shown")
      debug_assert(t.find("1600").is_some(), "DPI is read out")
      debug_assert(t.find("电量 76%").is_some(), "battery shows while connected")
      debug_assert(t.get("最小化").is_some() == !is_mac, "window controls only on Win/Linux")
      assert_clean_ui(t, "dpi_conn_dark_\{dark}_mac_\{is_mac}")
      worker.close()
      t.dispose()

      // 2. Disconnected
      let m_off = Mouse::new()
      m_off.connected.set(false)
      m_off.dpi.set(800)
      m_off.battery.set(-1)
      let w_off = ui::Worker::inline(stand_in(76))
      let t_off = window(
        m_off,
        w_off,
        [],
        show_window_controls=!is_mac,
        macos_inset=is_mac,
        platform=if is_mac { 0 } else { 5 },
      )
      if is_mac {
        t_off.fake.window_inset_flag = true
        t_off.fake.frame_requested = true
      }
      t_off.frame()
      debug_assert(t_off.find("未连接").is_some(), "offline subtitle")
      debug_assert(t_off.find("电量 76%").is_none(), "no battery while offline")
      assert_clean_ui(t_off, "dpi_off_dark_\{dark}_mac_\{is_mac}")
      w_off.close()
      t_off.dispose()

      // 3. Low battery
      let m_low = Mouse::new()
      m_low.connected.set(true)
      m_low.dpi.set(1200)
      m_low.battery.set(15)
      let w_low = ui::Worker::inline(stand_in(15))
      let t_low = window(
        m_low,
        w_low,
        [],
        show_window_controls=!is_mac,
        macos_inset=is_mac,
        platform=if is_mac { 0 } else { 3 },
      )
      t_low.frame()
      debug_assert(t_low.find("电量 15%").is_some(), "low battery badge shown")
      assert_clean_ui(t_low, "dpi_low_dark_\{dark}_mac_\{is_mac}")
      w_low.close()
      t_low.dispose()

      // 4. Permission denied
      let m_perm = Mouse::new()
      m_perm.connected.set(false)
      m_perm.perm_denied.set(true)
      m_perm.dpi.set(800)
      m_perm.battery.set(-1)
      let w_perm = ui::Worker::inline(stand_in(-1, perm_denied=true))
      let t_perm = window(
        m_perm,
        w_perm,
        [],
        show_window_controls=!is_mac,
        macos_inset=is_mac,
        close_label="关闭",
        platform=if is_mac { 0 } else { 5 },
      )
      t_perm.frame()
      debug_assert(t_perm.find("需要 HID 权限").is_some(), "perm_denied subtitle shown")
      assert_clean_ui(t_perm, "dpi_perm_dark_\{dark}_mac_\{is_mac}")
      w_perm.close()
      t_perm.dispose()
    }
  }
  lg::set_dark(None)
}

test "dynamic battery transitions 21 -> 20 -> 21 -> -1 on the same tree" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  m.battery.set(21)
  let worker = ui::Worker::inline(stand_in(21))
  let t = window(m, worker, [])
  t.frame()
  debug_assert(t.find("电量 21%").is_some(), "battery 21% shown in Success branch")
  assert_clean_ui(t, "dyn_bat_21")

  m.battery.set(20)
  t.frame(ms=16.0)
  debug_assert(t.find("电量 20%").is_some(), "battery 20% shown in Warning branch")
  debug_assert(t.find("电量 21%").is_none(), "old 21% badge hidden")
  assert_clean_ui(t, "dyn_bat_20")

  m.battery.set(21)
  t.frame(ms=16.0)
  debug_assert(t.find("电量 21%").is_some(), "battery 21% restored in Success branch")
  debug_assert(t.find("电量 20%").is_none(), "old 20% badge hidden")
  assert_clean_ui(t, "dyn_bat_21_again")

  m.battery.set(-1)
  t.frame(ms=16.0)
  debug_assert(t.find("电量 21%").is_none(), "negative battery hides badge")
  assert_clean_ui(t, "dyn_bat_neg")

  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "minimum 640x340 window with long device name passes apple ui and shadow clip gates" {
  lg::set_dark(Some(false))
  let m = Mouse::new()
  m.connected.set(true)
  m.dpi.set(3200)
  m.battery.set(88)
  m.device_name.set("PRO X SUPERLIGHT 2 DEX WIRELESS GAMING MOUSE")
  let worker = ui::Worker::inline(stand_in(88, device_name="PRO X SUPERLIGHT 2 DEX WIRELESS GAMING MOUSE"))
  let t = window(m, worker, [], width=640.0, height=340.0, show_window_controls=true, close_label="关闭")
  t.frame()
  debug_assert(t.find("3200").is_some(), "DPI shown at 640x340")
  debug_assert(t.find("电量 88%").is_some(), "battery shown at 640x340")
  assert_clean_ui(t, "min_640x340_long_name")
  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "the controls ask the worker, and its reads come back into the window" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  let worker = ui::Worker::inline(stand_in(55, device_name="G PRO X SUPERLIGHT 2"))
  let acts : Array[Int] = []
  let t = window(m, worker, acts)
  t.frame()
  // a preset: shown at once, written (the stand-in reads back what was written)
  t.press("1200")
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 1200, "a preset sets the DPI, got \{m.dpi.untracked()}")
  // lift-off distance
  t.press("高")
  t.frame(ms=16.0)
  debug_assert(m.lod.untracked() == 3, "the segmented control sets LOD 3, got \{m.lod.untracked()}")
  debug_assert(m.dpi.untracked() == 1200, "the DPI stays as LOD changes")
  // refresh: a read with the battery and dynamic device name comes back
  t.press("刷新")
  t.frame(ms=16.0)
  debug_assert(m.battery.untracked() == 55, "refresh reads the battery, got \{m.battery.untracked()}")
  debug_assert(m.device_name.untracked() == "G PRO X SUPERLIGHT 2", "refresh updates dynamic device name")
  // autostart toggle
  t.press("开机自启")
  t.frame(ms=16.0)
  debug_assert(m.autostart.untracked(), "the toggle asks for autostart and takes the worker's answer")
  // the window's own buttons
  t.press("最小化")
  t.press("关闭到托盘")
  debug_assert(acts.length() == 2 && acts[0] == 1 && acts[1] == 3, "minimize is 1, close (to the tray) is 3")
  assert_clean_ui(t, "dpi_after_controls")
  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "sequence readback ignores stale reads, snaps back on device rejection, and clamps slider above max" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  m.dpi.set(800)
  m.lod.set(3)
  let sets : Array[(Int, Int, Int)] = []
  let worker = ui::Worker::inline(fn(cmd : Cmd, _emit : (Ev) -> Unit) -> Unit {
    match cmd {
      Cmd::Set(seq, d, l) => sets.push((seq, d, l))
      _ => ()
    }
  })
  let reads : ui::EventQueue[Ev] = ui::EventQueue::new()
  let t = window(m, worker, [], reads=reads)
  t.frame()

  // UI initiates Set(seq=1, 1600, 3) optimistically.
  t.press("1600")
  t.frame(ms=16.0)
  debug_assert(sets.length() == 1, "expected 1 Set command, got \{sets.length()}")
  let (s_seq, s_dpi, s_lod) = sets[0]
  debug_assert(s_seq == 1 && s_dpi == 1600 && s_lod == 3, "expected Set(1, 1600, 3), got (\{s_seq}, \{s_dpi}, \{s_lod})")
  debug_assert(m.dpi.untracked() == 1600 && m.lod.untracked() == 3, "optimistic update applied")

  // Stale concurrent read (applied_seq=0 < pending_seq=1): DPI/LOD must be ignored, battery still updates.
  reads.emit(Ev::Read(true, 800, 2, 72, false, "PRO X2 SUPERSTRIKE", 0))
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 1600, "stale read must not overwrite DPI, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 3, "stale read must not overwrite LOD, got \{m.lod.untracked()}")
  debug_assert(m.battery.untracked() == 72, "stale read still updates battery, got \{m.battery.untracked()}")

  // Device rejection readback (applied_seq=1 >= pending_seq=1): must immediately snap back to real 800/2.
  reads.emit(Ev::Read(true, 800, 2, 72, false, "PRO X2 SUPERSTRIKE", 1))
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 800, "rejected write must immediately snap DPI back to 800, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 2, "rejected write must immediately snap LOD back to 2, got \{m.lod.untracked()}")

  // Out-of-slider-range DPI from external software (>4000): slider clamps safely while readout shows real value.
  reads.emit(Ev::Read(true, 6400, 2, 72, false, "PRO X2 SUPERSTRIKE", 1))
  t.frame(ms=16.0)
  debug_assert(m.dpi.untracked() == 6400, "real DPI 6400 preserved")
  debug_assert(t.find("6400").is_some(), "real DPI 6400 displayed")
  assert_clean_ui(t, "seq_reject_and_clamp")

  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "offline write failure reverts optimistic DPI/LOD (including 100-199 DPI) without clobbering offline startup" {
  lg::set_dark(Some(true))
  let m = Mouse::new()
  m.connected.set(true)
  m.dpi.set(150)
  m.lod.set(2)
  let sets : Array[(Int, Int, Int)] = []
  let worker = ui::Worker::inline(fn(cmd : Cmd, _emit : (Ev) -> Unit) -> Unit {
    match cmd {
      Cmd::Set(seq, d, l) => sets.push((seq, d, l))
      _ => ()
    }
  })
  let reads : ui::EventQueue[Ev] = ui::EventQueue::new()
  let t = window(m, worker, [], reads=reads)
  t.frame()

  // An offline startup snapshot at seq=0 must preserve config-seeded DPI (150) instead of clobbering it with 800.
  reads.emit(Ev::Read(false, 800, 3, -1, false, "PRO X2 SUPERSTRIKE", 0))
  t.frame(ms=16.0)
  debug_assert(!m.connected.untracked(), "offline startup marks disconnected")
  debug_assert(m.dpi.untracked() == 150, "offline startup must preserve seeded 150 DPI, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 2, "offline startup must preserve seeded LOD 2, got \{m.lod.untracked()}")

  // Online confirmed 150 DPI, then user clicks 1600 and the mouse disconnects before write completes.
  reads.emit(Ev::Read(true, 150, 2, 80, false, "PRO X2 SUPERSTRIKE", 0))
  t.frame(ms=16.0)
  t.press("1600")
  t.frame(ms=16.0)
  debug_assert(sets.length() == 1, "expected 1 Set command, got \{sets.length()}")
  let (seq, s_dpi, _) = sets[0]
  debug_assert(s_dpi == 1600, "expected Set(_, 1600, _), got dpi \{s_dpi}")
  debug_assert(m.dpi.untracked() == 1600, "optimistic update applied")

  reads.emit(Ev::Read(false, 150, 2, -1, false, "PRO X2 SUPERSTRIKE", seq))
  t.frame(ms=16.0)
  debug_assert(!m.connected.untracked(), "offline snapshot marks the mouse disconnected")
  debug_assert(m.dpi.untracked() == 150, "failed write must revert DPI to 150, got \{m.dpi.untracked()}")
  debug_assert(m.lod.untracked() == 2, "failed write must revert LOD to 2, got \{m.lod.untracked()}")

  worker.close()
  t.dispose()
  lg::set_dark(None)
}

test "macos 640x340 minimum size with 63-byte device name and low-battery or perm-denied passes gates" {
  let long_name = "Logitech G PRO X2 SUPERSTRIKE LIGHTSPEED WIRELESS GAMING MOUSE!"
  debug_assert(long_name.length() == 63, "test device name should be 63 bytes, got \{long_name.length()}")
  for dark in [false, true] {
    lg::set_dark(Some(dark))

    // Low battery at 640x340 macOS inset chrome
    let m_low = Mouse::new()
    m_low.connected.set(true)
    m_low.dpi.set(1600)
    m_low.battery.set(15)
    m_low.device_name.set(long_name)
    let w_low = ui::Worker::inline(stand_in(15, device_name=long_name))
    let t_low = window(
      m_low,
      w_low,
      [],
      width=640.0,
      height=340.0,
      show_window_controls=false,
      macos_inset=true,
      platform=0,
    )
    t_low.fake.window_inset_flag = true
    t_low.fake.frame_requested = true
    t_low.frame()
    debug_assert(t_low.find("电量 15%").is_some(), "low battery badge shown at 640x340 macOS")
    assert_clean_ui(t_low, "macos_640x340_63b_low_dark_\{dark}")
    w_low.close()
    t_low.dispose()

    // Permission denied at 640x340 macOS inset chrome with macOS-specific hint
    let mac_hint = "请在 系统设置 → 隐私与安全性 → 输入监控 中授权"
    let m_perm = Mouse::new()
    m_perm.connected.set(false)
    m_perm.perm_denied.set(true)
    m_perm.dpi.set(800)
    m_perm.battery.set(-1)
    m_perm.device_name.set(long_name)
    let w_perm = ui::Worker::inline(stand_in(-1, device_name=long_name, perm_denied=true))
    let t_perm = window(
      m_perm,
      w_perm,
      [],
      width=640.0,
      height=340.0,
      show_window_controls=false,
      macos_inset=true,
      perm_hint=mac_hint,
      platform=0,
    )
    t_perm.fake.window_inset_flag = true
    t_perm.fake.frame_requested = true
    t_perm.frame()
    debug_assert(t_perm.find("需要 HID 权限").is_some(), "perm denied subtitle shown at 640x340 macOS")
    debug_assert(t_perm.find(mac_hint).is_some(), "macos perm_hint shown")
    assert_clean_ui(t_perm, "macos_640x340_63b_perm_dark_\{dark}")
    w_perm.close()
    t_perm.dispose()
  }
  lg::set_dark(None)
}
