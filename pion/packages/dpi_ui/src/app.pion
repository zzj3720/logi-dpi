// MouseDPI's window, as invar's `lg` lays out an app: the Content Layer is solid (`lg::surface()`, no cards; its controls `flat`), the
// Liquid Glass floats over it (the PageShell's bar islands and the controls), never glass on glass. The page shell's top
// bar is the window's title bar (the window has none of the system's). What the window shows comes from `Mouse`
// (signals the worker's events write); what it asks goes to the worker (`Cmd`).

import "hostapi"
import "lg"
import "signals"
import "ui"
import "view"

/// What the window knows of the mouse.
pub struct Mouse {
  pub connected : signals::Signal[Bool]
  pub dpi : signals::Signal[Int]
  pub lod : signals::Signal[Int]
  pub battery : signals::Signal[Int]
  pub autostart : signals::Signal[Bool]
}

pub fn Mouse::new() -> Mouse {
  Mouse::{
    connected: signals::signal(false),
    dpi: signals::signal(800),
    lod: signals::signal(2),
    battery: signals::signal(-1),
    autostart: signals::signal(false),
  }
}

/// The slider's range and step (the sensor takes 100–44000; the hand wants 200–4000 in 50s).
pub let dpi_least : Int = 200

pub let dpi_most : Int = 4000

pub let dpi_step : Int = 50

/// How long after the window asks for a DPI/LOD a read is not taken for them (hostapi::now ms): a read the device side
/// did before the write landed is older than what is shown.
let settle_ms : Double = 1500.0

fn ink() -> Int64 {
  lg::surface().ink
}

fn ink_secondary() -> Int64 {
  lg::surface().ink_secondary
}

fn ink_tertiary() -> Int64 {
  lg::surface().ink_tertiary
}

/// The worker's events into `m` (bound before every frame; `asked_at[0]` is when the window last asked for a DPI/LOD).
fn take(m : Mouse, asked_at : Array[Double], ev : Ev) -> Unit {
  match ev {
    Ev::Read(ok, dpi, lod, battery) => {
      m.connected.set(ok)
      if ok {
        if hostapi::now() - asked_at[0] > settle_ms {
          m.dpi.set(dpi)
          m.lod.set(lod)
        }
        m.battery.set(battery)
      }
    }
    Ev::Autostarts(on) => m.autostart.set(on)
  }
}

/// The top bar's islands: the battery, refresh, and the window's own minimize / close (to the tray).
fn bar_islands(tr : view::View, m : Mouse, worker : ui::Worker[Cmd, Ev], window_act : (Int) -> Unit) -> Unit {
  <ui::Show in={tr} when=>{m.connected.get() && m.battery.get() >= 0} at_once>
    <lg::Badge
      label_by=>{"电量 \{m.battery.get()}%"}
      tone={if m.battery.get() <= 20 { .Warning } else { .Success }}
      dot
    />
  </ui::Show>
  <lg::BarPillGroup in={tr} height={36.0} label="鼠标">
    <lg::Button flat ghost height={32.0} pad_x={10.5} label="刷新" on_press=>{ let _ = worker.send(Cmd::Refresh) }>
      <lg::Icon kind={.Refresh} size={15.0} />
    </lg::Button>
  </lg::BarPillGroup>
  <lg::BarPillGroup in={tr} height={36.0} label="窗口">
    <lg::Button flat ghost height={32.0} pad_x={10.5} label="最小化" on_press=>{ window_act(1) }>
      <lg::Icon kind={.Minus} size={15.0} />
    </lg::Button>
    <lg::Button flat ghost height={32.0} pad_x={10.5} label="关闭到托盘" on_press=>{ window_act(3) }>
      <lg::Icon kind={.Close} size={15.0} />
    </lg::Button>
  </lg::BarPillGroup>
}

/// The left: the mouse itself and whether it is there, on the page (no card round it).
fn MouseSide(parent : view::View, m~ : Mouse, picture~ : String) -> Unit {
  <ui::Col in={parent} align={.Middle} along={.Middle} gap={10.0} width={196.0} rigid>
    <ui::Box width={120.0} height={180.0} alpha_by=>{if m.connected.get() { 1.0 } else { 0.45 }}>
      <ui::Image src={picture} width={120.0} height={180.0} contain max_px={640} />
    </ui::Box>
    <ui::Text
      size={12.5}
      color_by=>{ink_secondary()}
      text_by=>{if m.connected.get() { "LIGHTSPEED · HID++ 2.0" } else { "未连接 · 正在找接收器" }}
    />
  </ui::Col>
}

/// A row of the settings card: its name, then what sets it.
fn SettingRow(parent : view::View, name~ : String, children~ : (view::View) -> Unit) -> Unit {
  let _ = ui::Row(parent, align=.Middle, gap=12.0, height=52.0, pad_x=4.0, rigid=true, children=fn(r : view::View) -> Unit {
    <ui::Box in={r} width={72.0}>
      <ui::Text size={13.5} weight={500} color_by=>{ink()} text={name} />
    </ui::Box>
    let _ = ui::Row(r, grow=1.0, align=.Middle, gap=8.0, children~)
  })
}

/// A hairline between the settings card's rows.
fn Hairline(parent : view::View) -> Unit {
  <ui::Box in={parent} height={0.5} bg_by=>{lg::surface().separator} rigid />
}

/// The right: the DPI read out large with its stepper and slider on the page, then the settings as rows between hairlines.
fn DpiSide(parent : view::View, m~ : Mouse, worker~ : ui::Worker[Cmd, Ev], ask~ : (Int, Int) -> Unit) -> Unit {
  let set_dpi = fn(v : Int) -> Unit {
    if v != m.dpi.untracked() {
      ask(v, m.lod.untracked())
    }
  }
  <ui::Col in={parent} grow={1.0} gap={10.0}>
    <ui::Row align={.End} pad_x={4.0} rigid>
      <ui::Row align={.End} gap={8.0} rigid>
        <ui::Text size={56.0} weight={700} color_by=>{ink()} text_by=>{m.dpi.get().to_string()} />
        <ui::Box pad_y={10.0}>
          <ui::Text size={15.0} weight={600} color_by=>{ink_secondary()} text="DPI" />
        </ui::Box>
      </ui::Row>
      <ui::Spacer />
      <ui::Box pad_y={10.0}>
        <lg::Stepper
          value_by=>{m.dpi.get()}
          on_change={fn(v : Int) -> Unit { set_dpi(v) }}
          min={dpi_least}
          max={dpi_most}
          step={dpi_step}
          label="DPI ±50"
          show_value={false}
          flat
        />
      </ui::Box>
    </ui::Row>
    // Dragging the slider moves the very pointer whose DPI it sets: the read-out follows the hand (`on_change`),
    // the mouse is written once the hand lets go (`on_commit`).
    <ui::Col gap={6.0} pad_x={4.0} rigid>
      <lg::Slider
        value_by=>{m.dpi.get().to_double()}
        on_change={fn(v : Double) -> Unit { m.dpi.set(v.to_int()) }}
        on_commit={fn(v : Double) -> Unit { ask(v.to_int(), m.lod.untracked()) }}
        label="DPI"
        min={dpi_least.to_double()}
        max={dpi_most.to_double()}
        step={dpi_step.to_double()}
      />
      <ui::Row along={.Between} rigid>
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="200" />
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="1000" />
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="2000" />
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="3000" />
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="4000" />
      </ui::Row>
    </ui::Col>
    <ui::Col gap={0.0} rigid>
      <Hairline />
      <SettingRow name="常用档位">
        <lg::Chip flat label="400" selected_by=>{m.dpi.get() == 400} on_press=>{ set_dpi(400) } />
        <lg::Chip flat label="800" selected_by=>{m.dpi.get() == 800} on_press=>{ set_dpi(800) } />
        <lg::Chip flat label="1200" selected_by=>{m.dpi.get() == 1200} on_press=>{ set_dpi(1200) } />
        <lg::Chip flat label="1600" selected_by=>{m.dpi.get() == 1600} on_press=>{ set_dpi(1600) } />
        <lg::Chip flat label="3200" selected_by=>{m.dpi.get() == 3200} on_press=>{ set_dpi(3200) } />
      </SettingRow>
      <Hairline />
      <SettingRow name="抬起距离">
        <lg::Segmented
          flat
          labels={["低", "中", "高"]}
          selected_by=>{
            let l = m.lod.get()
            if l < 1 { 0 } else if l > 3 { 2 } else { l - 1 }
          }
          on_select={fn(i : Int) -> Unit {
            if i + 1 != m.lod.untracked() {
              ask(m.dpi.untracked(), i + 1)
            }
          }}
          width={216.0}
        />
      </SettingRow>
      <Hairline />
      <SettingRow name="开机自启">
        <lg::Toggle
          on_by=>{m.autostart.get()}
          on_change={fn(on : Bool) -> Unit { let _ = worker.send(Cmd::Autostart(on)) }}
          label="开机自启"
        />
        <ui::Box pad_x={4.0}>
          <ui::Text size={12.0} color_by=>{ink_tertiary()} text="改动自动保存 · 唤醒后自动恢复" />
        </ui::Box>
      </SettingRow>
    </ui::Col>
  </ui::Col>
}

/// The whole window. `window_act`: the window's own buttons (1 minimize, 3 close: put away to the tray); `reads`: what
/// the device side reads without being asked (as the mouse wakes, every 30 s).
pub fn app(
  root : view::View,
  m : Mouse,
  worker : ui::Worker[Cmd, Ev],
  window_act~ : (Int) -> Unit = fn(_w : Int) -> Unit { () },
  reads? : ui::EventQueue[Ev],
  picture~ : String = "mouse.png",
) -> Unit {
  let asked_at : Array[Double] = [-100000.0]
  worker.bind(fn(ev : Ev) -> Unit { take(m, asked_at, ev) })
  // reads the device side does on its own (a thread that waits on them), taken as the worker's are
  match reads {
    Some(q) => {
      let _ = ui::on_before_frame(fn() { let _ = q.drain(fn(ev : Ev) -> Unit { take(m, asked_at, ev) }) })
    }
    None => ()
  }
  // shown at once; written by the worker (the newest asked), its read back taken once it has settled
  let ask = fn(dpi : Int, lod : Int) -> Unit {
    asked_at[0] = hostapi::now()
    m.dpi.set(dpi)
    m.lod.set(lod)
    let _ = worker.send(Cmd::Set(dpi, lod))
  }
  <lg::PageShell
    in={root}
    title="PRO X2 SUPERSTRIKE"
    subtitle_by=>{if m.connected.get() { "已连接" } else { "未连接" }}
    moves_window
    grouped
    trailing={fn(tr : view::View) -> Unit { bar_islands(tr, m, worker, window_act) }}
  >
    <ui::Row pad_x={16.0} gap={12.0} align={.Start}>
      <MouseSide m={m} picture={picture} />
      <DpiSide m={m} worker={worker} ask={ask} />
    </ui::Row>
  </lg::PageShell>
}
