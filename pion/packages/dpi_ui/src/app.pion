// MouseDPI's window, as invar's `lg` lays out an app: the Content Layer is solid (`lg::surface()`, no cards;
// controls inside `<lg::PageShell>` body inherit `SurfaceContext::Content` automatically), the Liquid Glass floats
// over it (the PageShell's bar islands), never glass on glass. The page shell's top bar is the window's title bar
// (inset on all three platforms). What the window shows comes from `Mouse` (signals the worker's events write);
// what it asks goes to the worker (`Cmd`).

import "lg"
import "signals"
import "ui"
import "view"

/// What the window knows of the mouse.
pub struct Mouse {
  pub connected : signals::Signal[Bool]
  pub dpi : signals::Signal[Int]
  pub lod : signals::Signal[Int]
  pub battery : signals::Signal[Int]
  pub autostart : signals::Signal[Bool]
  pub perm_denied : signals::Signal[Bool]
  pub device_name : signals::Signal[String]
}

pub fn Mouse::new() -> Mouse {
  Mouse::{
    connected: signals::signal(false),
    dpi: signals::signal(800),
    lod: signals::signal(2),
    battery: signals::signal(-1),
    autostart: signals::signal(false),
    perm_denied: signals::signal(false),
    device_name: signals::signal("PRO X2 SUPERSTRIKE"),
  }
}

/// The slider's range and step (the sensor takes 100–44000; the hand wants 200–4000 in 50s).
pub let dpi_least : Int = 200

pub let dpi_most : Int = 4000

pub let dpi_step : Int = 50

fn ink() -> Int64 {
  lg::surface().ink
}

fn ink_secondary() -> Int64 {
  lg::surface().ink_secondary
}

fn ink_tertiary() -> Int64 {
  lg::surface().ink_tertiary
}

/// The worker's events into `m` (bound before every frame; `pending_seq[0]` is the latest requested write sequence,
/// and `active_token[0]` is the atomic device target token carried by the latest snapshot).
fn take(m : Mouse, pending_seq : Array[Int], active_token : Array[Int], ev : Ev) -> Unit {
  match ev {
    Ev::Read(ok, dpi, lod, battery, perm_denied, device_name, applied_seq, target_token) => {
      active_token[0] = target_token
      m.connected.set(ok)
      m.perm_denied.set(perm_denied)
      if device_name != "" {
        m.device_name.set(device_name)
      }
      if applied_seq >= pending_seq[0] {
        if ok {
          m.dpi.set(dpi)
          m.lod.set(lod)
        } else if pending_seq[0] > 0 {
          // Offline snapshot after a failed user write still carries the last confirmed device values
          // (device range starts at 100 DPI, below the 200 DPI slider floor): undo the optimistic values
          // without clobbering config-seeded DPI on an offline startup (where pending_seq == 0).
          if dpi >= 100 {
            m.dpi.set(dpi)
          }
          if lod >= 1 && lod <= 3 {
            m.lod.set(lod)
          }
        }
      }
      if ok {
        m.battery.set(battery)
      }
    }
    Ev::Autostarts(on) => m.autostart.set(on)
  }
}

/// The top bar's islands: the responsive battery badge, refresh, and (on Windows/Linux) minimize / close.
fn bar_islands(
  tr : view::View,
  m : Mouse,
  worker : ui::Worker[Cmd, Ev],
  window_act : (Int) -> Unit,
  show_window_controls : Bool,
  close_label : String,
) -> Unit {
  <ui::Show in={tr} when=>{m.connected.get() && m.battery.get() > 20} at_once>
    <lg::Badge label_by=>{"电量 \{m.battery.get()}%"} tone={.Success} dot />
  </ui::Show>
  <ui::Show in={tr} when=>{m.connected.get() && m.battery.get() >= 0 && m.battery.get() <= 20} at_once>
    <lg::Badge label_by=>{"电量 \{m.battery.get()}%"} tone={.Warning} dot />
  </ui::Show>
  <lg::BarPillGroup in={tr} height={36.0} label="鼠标">
    <lg::Button flat ghost height={32.0} pad_x={10.5} label="刷新" on_press=>{ let _ = worker.send(Cmd::Refresh) }>
      <lg::Icon kind={.Refresh} size={15.0} />
    </lg::Button>
  </lg::BarPillGroup>
  if show_window_controls {
    <lg::BarPillGroup in={tr} height={36.0} label="窗口">
      <lg::Button flat ghost height={32.0} pad_x={10.5} label="最小化" on_press=>{ window_act(1) }>
        <lg::Icon kind={.Minus} size={15.0} />
      </lg::Button>
      <lg::Button flat ghost height={32.0} pad_x={10.5} label={close_label} on_press=>{ window_act(3) }>
        <lg::Icon kind={.Close} size={15.0} />
      </lg::Button>
    </lg::BarPillGroup>
  }
}

/// The left: the mouse itself and connection/permission state, on the page (no card round it).
fn MouseSide(parent : view::View, m~ : Mouse, picture~ : String, perm_hint~ : String) -> Unit {
  <ui::Col in={parent} align={.Middle} along={.Middle} gap={10.0} width={196.0} rigid>
    <ui::Box width={120.0} height={180.0} alpha_by=>{if m.connected.get() { 1.0 } else { 0.45 }}>
      <ui::Image src={picture} width={120.0} height={180.0} contain max_px={640} />
    </ui::Box>
    <ui::Box pad_x={8.0}>
      <ui::Text
        size={12.5}
        wrap
        center
        color_by=>{ink_secondary()}
        text_by=>{
          if m.perm_denied.get() {
            perm_hint
          } else if m.connected.get() {
            "Logitech HID++ 2.0"
          } else {
            "未连接，正在查找接收器"
          }
        }
      />
    </ui::Box>
  </ui::Col>
}

/// A row of the settings list: its name, then what sets it.
fn SettingRow(parent : view::View, name~ : String, children~ : (view::View) -> Unit) -> Unit {
  let _ = ui::Row(parent, align=.Middle, gap=12.0, height=52.0, pad_x=4.0, rigid=true, children=fn(r : view::View) -> Unit {
    <ui::Box in={r} width={72.0}>
      <ui::Text size={13.5} weight={500} color_by=>{ink()} text={name} />
    </ui::Box>
    let _ = ui::Row(r, grow=1.0, align=.Middle, gap=8.0, children~)
  })
}

/// A hairline between the settings rows.
fn Hairline(parent : view::View) -> Unit {
  <ui::Box in={parent} height={0.5} bg_by=>{lg::surface().separator} rigid />
}

/// The right: the DPI read out large with its stepper and slider on the page, then the settings as rows between hairlines.
fn DpiSide(parent : view::View, m~ : Mouse, worker~ : ui::Worker[Cmd, Ev], ask~ : (Int, Int) -> Unit) -> Unit {
  let set_dpi = fn(v : Int) -> Unit {
    if v != m.dpi.untracked() {
      ask(v, m.lod.untracked())
    }
  }
  <ui::Col in={parent} grow={1.0} gap={10.0}>
    <ui::Row align={.End} pad_x={4.0} rigid>
      <ui::Row align={.End} gap={8.0} rigid>
        <ui::Text size={56.0} weight={700} color_by=>{ink()} text_by=>{m.dpi.get().to_string()} />
        <ui::Box pad_y={10.0}>
          <ui::Text size={15.0} weight={600} color_by=>{ink_secondary()} text="DPI" />
        </ui::Box>
      </ui::Row>
      <ui::Spacer />
      <ui::Box pad_y={10.0}>
        <lg::Stepper
          value_by=>{m.dpi.get()}
          on_change={fn(v : Int) -> Unit { set_dpi(v) }}
          min={dpi_least}
          max={dpi_most}
          step={dpi_step}
          label="DPI ±50"
          show_value={false}
        />
      </ui::Box>
    </ui::Row>
    // Dragging the slider moves the very pointer whose DPI it sets: the read-out follows the hand (`on_change`),
    // the mouse is written once the hand lets go (`on_commit`).
    <ui::Col gap={6.0} pad_x={4.0} rigid>
      <lg::Slider
        value_by=>{
          let v = m.dpi.get()
          let clamped = if v < dpi_least { dpi_least } else if v > dpi_most { dpi_most } else { v }
          clamped.to_double()
        }
        on_change={fn(v : Double) -> Unit { m.dpi.set(v.to_int()) }}
        on_commit={fn(v : Double) -> Unit { ask(v.to_int(), m.lod.untracked()) }}
        label="DPI"
        min={dpi_least.to_double()}
        max={dpi_most.to_double()}
        step={dpi_step.to_double()}
      />
      <ui::Row along={.Between} rigid>
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="200" />
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="1000" />
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="2000" />
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="3000" />
        <ui::Text size={11.0} weight={500} color_by=>{ink_tertiary()} text="4000" />
      </ui::Row>
    </ui::Col>
    <ui::Col gap={0.0} rigid>
      <Hairline />
      <SettingRow name="常用档位">
        <lg::Chip label="400" selected_by=>{m.dpi.get() == 400} on_press=>{ set_dpi(400) } />
        <lg::Chip label="800" selected_by=>{m.dpi.get() == 800} on_press=>{ set_dpi(800) } />
        <lg::Chip label="1200" selected_by=>{m.dpi.get() == 1200} on_press=>{ set_dpi(1200) } />
        <lg::Chip label="1600" selected_by=>{m.dpi.get() == 1600} on_press=>{ set_dpi(1600) } />
        <lg::Chip label="3200" selected_by=>{m.dpi.get() == 3200} on_press=>{ set_dpi(3200) } />
      </SettingRow>
      <Hairline />
      <SettingRow name="抬起距离">
        <lg::Segmented
          labels={["低", "中", "高"]}
          selected_by=>{
            let l = m.lod.get()
            if l < 1 { 0 } else if l > 3 { 2 } else { l - 1 }
          }
          on_select={fn(i : Int) -> Unit {
            if i + 1 != m.lod.untracked() {
              ask(m.dpi.untracked(), i + 1)
            }
          }}
          width={216.0}
        />
      </SettingRow>
      <Hairline />
      <SettingRow name="开机自启">
        <lg::Toggle
          on_by=>{m.autostart.get()}
          on_change={fn(on : Bool) -> Unit { let _ = worker.send(Cmd::Autostart(on)) }}
          label="开机自启"
        />
        <ui::Box pad_x={4.0}>
          <ui::Text size={12.0} color_by=>{ink_tertiary()} text="改动自动保存，唤醒后自动恢复" />
        </ui::Box>
      </SettingRow>
    </ui::Col>
  </ui::Col>
}

/// The whole window.
/// - `window_act`: the window's own buttons (1 minimize, 3 close).
/// - `reads`: what the device side reads without being asked (as the mouse wakes, every 30 s).
/// - `show_window_controls`: true on Windows/Linux (custom minimize/close buttons), false on macOS (native traffic lights).
/// - `macos_inset`: true on macOS to reserve a reactive 68pt leading spacer while traffic lights are inset.
/// - `close_label`: accessible label for the close button ("关闭到托盘" when tray is available, else "关闭").
/// - `perm_hint`: platform-specific guidance shown when HID permission is denied.
pub fn app(
  root : view::View,
  m : Mouse,
  worker : ui::Worker[Cmd, Ev],
  window_act~ : (Int) -> Unit = fn(_w : Int) -> Unit { () },
  reads? : ui::EventQueue[Ev],
  picture~ : String = "mouse.png",
  show_window_controls~ : Bool = true,
  macos_inset~ : Bool = false,
  close_label~ : String = "关闭到托盘",
  perm_hint~ : String = "请安装 udev 规则或在系统设置中授予权限",
) -> Unit {
  let pending_seq : Array[Int] = [0]
  let active_token : Array[Int] = [0]
  worker.bind(fn(ev : Ev) -> Unit { take(m, pending_seq, active_token, ev) })
  // reads the device side does on its own (a thread that waits on them), taken as the worker's are
  match reads {
    Some(q) => {
      let _ = ui::on_before_frame(fn() { let _ = q.drain(fn(ev : Ev) -> Unit { take(m, pending_seq, active_token, ev) }) })
    }
    None => ()
  }
  // shown at once; written by the worker with a monotonic sequence number and the UI-seen device target token
  // so stale reads are ignored, cross-device spillover is impossible, and real readbacks apply immediately.
  let ask = fn(dpi : Int, lod : Int) -> Unit {
    let seq = pending_seq[0] + 1
    pending_seq[0] = seq
    m.dpi.set(dpi)
    m.lod.set(lod)
    let _ = worker.send(Cmd::Set(seq, active_token[0], dpi, lod))
  }
  <lg::PageShell
    in={root}
    title_by=>{m.device_name.get()}
    subtitle_by=>{
      if m.perm_denied.get() {
        "需要 HID 权限"
      } else if m.connected.get() {
        "已连接"
      } else {
        "未连接"
      }
    }
    moves_window
    grouped
    leading={fn(l : view::View) -> Unit {
      <ui::Show in={l} when=>{macos_inset && ui::window_inset_now()} at_once>
        <ui::Spacer width={68.0} />
      </ui::Show>
    }}
    trailing={fn(tr : view::View) -> Unit {
      bar_islands(tr, m, worker, window_act, show_window_controls, close_label)
    }}
  >
    <ui::Row pad_x={16.0} gap={12.0} align={.Start}>
      <MouseSide m={m} picture={picture} perm_hint={perm_hint} />
      <DpiSide m={m} worker={worker} ask={ask} />
    </ui::Row>
  </lg::PageShell>
}
